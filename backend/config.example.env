# Copy to backend/.env. Never commit backend/.env or send its contents in chat.
# Use "fixtures" to try the local API without database credentials.
FLOODSAFE_DATA_MODE=postgres
FLOODSAFE_ALLOW_DEMO_DATA=true

# Supabase dashboard -> Connect -> Session pooler (IPv4-compatible).
# Enter the host/user from your own project; password is entered as-is,
# without URL encoding. No service-role key is needed for this increment.
FLOODSAFE_DB_HOST=
FLOODSAFE_DB_PORT=5432
FLOODSAFE_DB_NAME=postgres
FLOODSAFE_DB_USER=
FLOODSAFE_DB_PASSWORD=
FLOODSAFE_DB_SSLMODE=require

# Exact browser origins only; no wildcard credentials or public hosting needed.
FLOODSAFE_CORS_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]
