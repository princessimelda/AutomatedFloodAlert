# Copy the required fields into ignored backend/.env.notifications.
# Operator keys are server-only, unique, at least 32 characters. Never put them in Flutter.
# Empty means all privileged alert writes are disabled. Use the provisioning command to generate keys.
FLOODSAFE_ALERT_PRINCIPALS={}
FLOODSAFE_AUTH_URL=
FLOODSAFE_AUTH_PUBLISHABLE_KEY=
FLOODSAFE_SMS_ENABLED=false
FLOODSAFE_NOTIFICATION_WORKER_ENABLED=false
FLOODSAFE_SMS_ACCOUNT_SID=
FLOODSAFE_SMS_AUTH_TOKEN=
FLOODSAFE_SMS_FROM=
# Enrolled tester labels map to E.164 numbers, never to numbers submitted in API requests.
FLOODSAFE_SMS_TEST_RECIPIENTS={}
